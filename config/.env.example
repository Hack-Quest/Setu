# =============================================================================
# SETU — Environment Variables Template
# =============================================================================
# Copy this file to config/.env and fill in your real values.
#   cp config/.env.example config/.env
#
# NEVER commit config/.env — it is excluded by .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------

# Google Gemini API key (used for emergency classification & trust scoring)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (optional fallback LLM)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here


# -----------------------------------------------------------------------------
# Google Maps / Geocoding
# -----------------------------------------------------------------------------

# Google Maps Platform API key (used for geocoding location text → lat/lng)
# Enable: Geocoding API, Maps JavaScript API
# Get one at: https://console.cloud.google.com/google/maps-apis/
GOOGLE_MAPS_KEY=your_google_maps_api_key_here


# -----------------------------------------------------------------------------
# Firebase / Firestore
# -----------------------------------------------------------------------------

# Your Firebase project ID (found in Project Settings → General)
# Example: my-project-abc123
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Authentication method: Application Default Credentials (ADC) are used by default.
# Run the following to authenticate locally:
#   gcloud auth application-default login
#
# For production / Cloud Run, attach a Service Account with Firestore permissions.
# No extra variable needed when running on Cloud Run with a proper service account.


# -----------------------------------------------------------------------------
# Email (OTP delivery via Gmail SMTP)
# -----------------------------------------------------------------------------

# Gmail address used as the OTP sender
GMAIL_SENDER=your_gmail_address@gmail.com

# Gmail App Password (NOT your regular password — requires 2FA to be enabled)
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password_here


# -----------------------------------------------------------------------------
# Weather API (optional — used for environmental context)
# -----------------------------------------------------------------------------

# OpenWeatherMap API key
# Get one at: https://openweathermap.org/api
WEATHER_API=your_openweathermap_api_key_here


# -----------------------------------------------------------------------------
# Backend / Auth
# -----------------------------------------------------------------------------

# Shared secret token used to authenticate API requests from trusted clients.
# Use a long, randomly generated string in production.
# Example (generate with): python -c "import secrets; print(secrets.token_hex(32))"
SECRET_TOKEN=change_me_use_a_long_random_string

# Base URL of the running backend (used by tests and the CLI)
# Local development:
SETU_API_BASE_URL=http://127.0.0.1:8080/
SETU_BASE_URL=http://127.0.0.1:8080/

# Cloud Run deployment example:
# SETU_API_BASE_URL=https://setu-api-XXXXX.run.app/
# SETU_BASE_URL=https://setu-api-XXXXX.run.app/
